#!/bin/bash
#
# Kali Linux installation script for LightShow Pi on Raspberry Pi
#

## Package manager installation command
INSTALL_COMMAND="apt-get install -q=2 -y"

## Update package repository index
echo -ne "\e[1;34mlightshowpi \e[m" >&2
echo "Updating apt package list..."
apt-get update -q=2

## Check BLAS library in Kali/Debian repos
BLAS_DEP="libopenblas-dev"
if apt-cache show libatlas-base-dev >/dev/null 2>&1; then
    BLAS_DEP="libatlas-base-dev"
fi

## System packages to be installed via apt
SYSTEM_DEPS=(python3-pip python3-dev curl faad flac gcc git lame mpg123 make \
             python3-numpy python3-setuptools unzip vorbis-tools \
             cython3 pianobar libjpeg-dev libtiff-dev libasound2-dev \
             alsa-utils python-is-python3 python3-mutagen python3-simplejson \
             python3-pil python3-serial python3-spidev $BLAS_DEP)

# Add python3-alsaaudio if available in apt to speed up installation
if apt-cache show python3-alsaaudio >/dev/null 2>&1; then
    SYSTEM_DEPS+=(python3-alsaaudio)
fi

## Python dependencies to be installed via pip
PYTHON_DEPS=(Beautifulsoup4 mutagen simplejson twython emoji \
             spidev BiblioPixel pillow pyserial pyalsaaudio)

## Miscellaneous checks

# GL driver setting (only if raspi-config or kalipi-config is present)
if command -v raspi-config >/dev/null 2>&1; then
    raspi-config nonint do_gldriver G3 2>/dev/null || true
elif command -v kalipi-config >/dev/null 2>&1; then
    kalipi-config nonint do_gldriver G3 2>/dev/null || true
fi

# Ensure ffmpeg is installed
echo -ne "\e[0;31mNOTE:\e[m " >&2
echo "Installing ffmpeg..."
$INSTALL_COMMAND ffmpeg
