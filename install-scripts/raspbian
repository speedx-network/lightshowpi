#!/bin/bash

## Package manager installation command with lock timeout
INSTALL_COMMAND="apt-get -o DPkg::Lock::Timeout=60 install -q=2 -y"

## Check BLAS library in repos (Debian 12/Bookworm moved from ATLAS to OpenBLAS)
BLAS_DEP="libopenblas-dev"
if apt-cache policy libopenblas-dev 2>/dev/null | grep -E 'Candidate:' | grep -q '(none)'; then
    if apt-cache policy libatlas-base-dev 2>/dev/null | grep -E 'Candidate:' | grep -qv '(none)'; then
        BLAS_DEP="libatlas-base-dev"
    fi
fi

## Python dependencies to be installed
PYTHON_DEPS=(numpy Beautifulsoup4 mutagen simplejson twython emoji \
             spidev BiblioPixel pillow pyserial pyalsaaudio)

## System packages to be installed
SYSTEM_DEPS=(python3-pip python3-dev curl faad flac gcc git lame mpg123 make \
             python3-numpy python3-setuptools unzip vorbis-tools \
             cython3 pianobar libjpeg-dev libtiff-dev libasound2-dev \
             libcrypt-dev alsa-utils python-is-python3 python3-bs4 ffmpeg $BLAS_DEP)

# Add python3-alsaaudio if available in apt
if apt-cache show python3-alsaaudio >/dev/null 2>&1; then
    SYSTEM_DEPS+=(python3-alsaaudio)
fi

## Miscellaneous checks

# Recent versions of the full Raspbian distro are installing these
# Remove them if present so pip can install cleanly
apt-get -y remove python-simplejson 2>/dev/null || true
apt-get -y remove python-serial 2>/dev/null || true
apt-get -y remove python-spidev 2>/dev/null || true

# Some versions are now installing GL by default, disable it
# if you dont, you get "Unable to enable V3D" from the FFT code
if command -v raspi-config >/dev/null 2>&1; then
    raspi-config nonint do_gldriver G3 2>/dev/null || true
fi

return 0 2>/dev/null || exit 0
